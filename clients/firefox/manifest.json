{
  "manifest_version": 3,
  "name": "DAL — Queue in DAL",
  "version": "1.0.0",
  "description": "Right-click any link to queue it for download in DAL",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["*://*/api/*"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg"
  }
}
